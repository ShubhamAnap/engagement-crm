# =============================================================================
# EnerTech Engage — environment variables
# =============================================================================
# Copy this file to `.env` and fill in real values.
# Never commit `.env`. Never paste service_role / OpenAI keys into chat.
# =============================================================================

# App
VITE_APP_URL=http://localhost:8080

# Public website chat widget (same value for both)
WIDGET_PUBLIC_KEY=generate-a-long-random-string
VITE_WIDGET_PUBLIC_KEY=generate-a-long-random-string

# Supabase (Project Settings → API)
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# Server-only — used by TanStack server functions, NOT exposed to the browser
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# OpenAI (needed from AI / Website chat / Knowledge Base phases)
OPENAI_API_KEY=your_openai_api_key
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Optional — Web search AI tool (Tavily). Leave blank to keep web_search disabled/unavailable.
TAVILY_API_KEY=
# WEB_SEARCH_API_KEY=  # alias for TAVILY_API_KEY

# WhatsApp Cloud API (Meta) — optional; can also be saved in Channels → WhatsApp Configure
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_DISPLAY_PHONE=
# Meta App Secret — required in production for X-Hub-Signature-256 on WA/FB/IG webhooks
META_APP_SECRET=

# Gmail OAuth (n8n-style) — optional; can also save Client ID/Secret under Channels → Gmail
# Google Cloud → OAuth Client (Web) → enable Gmail API
# Redirect URI: {VITE_APP_URL}/api/oauth/gmail/callback
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
# Optional override (defaults to {VITE_APP_URL}/api/oauth/gmail/callback)
GMAIL_REDIRECT_URI=

# Email channel (SMTP + inbound webhook) — optional fallback; prefer Gmail OAuth above for marketing
EMAIL_FROM=
EMAIL_FROM_NAME=EnerTech Engage
EMAIL_SMTP_HOST=
EMAIL_SMTP_PORT=587
EMAIL_SMTP_SECURE=false
EMAIL_SMTP_USER=
EMAIL_SMTP_PASS=
# Required in production for /api/webhooks/email (header x-enertech-email-secret)
EMAIL_INBOUND_SECRET=

# Facebook / Instagram Messaging (Meta Page) — optional; can also be saved in Channels Configure
# Shared Page token often works for both; verify tokens can match.
META_PAGE_ID=
META_PAGE_ACCESS_TOKEN=
META_VERIFY_TOKEN=
FACEBOOK_PAGE_ID=
FACEBOOK_ACCESS_TOKEN=
FACEBOOK_VERIFY_TOKEN=
INSTAGRAM_PAGE_ID=
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_VERIFY_TOKEN=
INSTAGRAM_ACCOUNT_ID=

# IndiaMART Lead Manager — optional; can also be saved in Channels → IndiaMART Configure
# Generate key: https://seller.indiamart.com/leadmanager/crmapi
INDIAMART_CRM_KEY=
# Required in production for /api/webhooks/indiamart (header x-enertech-indiamart-secret)
INDIAMART_PUSH_SECRET=

# Brainmine CRM+ — optional; can also be saved in Channels → Brainmine Configure
# UI values override env. Hosted CRM: https://brainmineai.in (ERPNext-style token auth).
BRAINMINE_API_BASE_URL=https://brainmineai.in
BRAINMINE_API_KEY=
BRAINMINE_API_SECRET=
BRAINMINE_AUTH_STYLE=token
BRAINMINE_LEADS_PATH=/api/resource/Lead
# Max leads pulled per Sync now (10–200). UI can override.
BRAINMINE_SYNC_LIMIT=30

# TradeIndia My Inquiry API — optional; can also be saved in Channels → TradeIndia Configure
TRADEINDIA_USERID=
TRADEINDIA_PROFILE_ID=
TRADEINDIA_API_KEY=

# Automation cron (due follow-ups + daily Follow-up Agent proposal). Required in production.
CRON_SECRET=

# Optional — WhatsApp template for Follow-up Agent daily campaign (else picks an APPROVED template with "follow" in the name)
# FOLLOWUP_WA_TEMPLATE_NAME=enertech_followup
# FOLLOWUP_WA_TEMPLATE_LANG=en
# Optional: welcome template when customer greets on a cold start outside an open 24h window
# Never use Meta sample hello_world — use your approved EnerTech welcome template name
# WHATSAPP_GREETING_TEMPLATE_NAME=hello_enertech
# WHATSAPP_GREETING_TEMPLATE_LANG=en

# Optional observability (Phase 3) — leave blank for console-only logs
SENTRY_DSN=
VITE_SENTRY_DSN=

# First admin seed (used once during Phase 0 setup — change after first login)
SEED_ADMIN_EMAIL=admin@enertechups.com
SEED_ADMIN_PASSWORD=change-me-strong-password
